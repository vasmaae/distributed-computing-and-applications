HTTP_HOST=0.0.0.0
HTTP_PORT=8080

DATABASE_HOST=postgres
DATABASE_PORT=5432
DATABASE_USERNAME=postgres
DATABASE_PASSWORD=replace-with-the-password-from-database-env
DATABASE_DATABASE=reports
DATABASE_SSL_MODE=disable

EMPLOYEES_CLIENT_HOST=employees-service
EMPLOYEES_CLIENT_PORT=80

QUEUE_BROKERS=kafka-1:9092,kafka-2:9092,kafka-3:9092
QUEUE_TOPIC=reports.files

JWT_SECRET=replace-with-at-least-32-random-characters
OTEL_EXPORTER_OTLP_ENDPOINT=http://jaeger:4318
