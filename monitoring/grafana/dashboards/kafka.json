{
  "uid": "kafka",
  "title": "Kafka overview",
  "description": "Брокеры, ISR, consumer lag и доставка отчётов. Метрики Kafka exporter, без JMX.",
  "tags": [
    "labs",
    "kafka"
  ],
  "schemaVersion": 41,
  "version": 1,
  "editable": false,
  "timezone": "browser",
  "refresh": "5s",
  "time": {
    "from": "now-15m",
    "to": "now"
  },
  "links": [
    {
      "title": "Services",
      "url": "http://localhost:3000/d/services",
      "type": "link",
      "targetBlank": false
    },
    {
      "title": "Kafka",
      "url": "http://localhost:3000/d/kafka",
      "type": "link",
      "targetBlank": false
    },
    {
      "title": "S3",
      "url": "http://localhost:3000/d/s3",
      "type": "link",
      "targetBlank": false
    }
  ],
  "panels": [
    {
      "id": 1,
      "title": "Брокеры в метаданных",
      "type": "stat",
      "description": "Ожидается 3. Это данные Kafka metadata, а не отдельная проверка TCP каждого брокера.",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "gridPos": {
        "x": 0,
        "y": 0,
        "w": 12,
        "h": 4
      },
      "targets": [
        {
          "refId": "A",
          "expr": "kafka_brokers{job=\"kafka\"}",
          "legendFormat": "Брокеры",
          "instant": true,
          "range": false
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "color": {
            "mode": "thresholds"
          },
          "decimals": 0,
          "noValue": "Нет данных",
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "red",
                "value": null
              },
              {
                "color": "yellow",
                "value": 2
              },
              {
                "color": "green",
                "value": 3
              }
            ]
          }
        },
        "overrides": []
      },
      "options": {
        "colorMode": "value",
        "graphMode": "none",
        "textMode": "value_and_name",
        "orientation": "horizontal"
      }
    },
    {
      "id": 2,
      "title": "Проблемные партиции",
      "type": "stat",
      "description": "Все топики. Under-replicated: ISR меньше RF. Ниже min ISR: ISR меньше 2, запись с acks=all недоступна.",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "gridPos": {
        "x": 12,
        "y": 0,
        "w": 12,
        "h": 4
      },
      "targets": [
        {
          "refId": "A",
          "expr": "sum(kafka_topic_partition_under_replicated_partition{job=\"kafka\"})",
          "legendFormat": "Under-replicated",
          "instant": true,
          "range": false
        },
        {
          "refId": "B",
          "expr": "sum(kafka_topic_partition_in_sync_replica{job=\"kafka\"} < bool 2)",
          "legendFormat": "Ниже min ISR = 2",
          "instant": true,
          "range": false
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "color": {
            "mode": "thresholds"
          },
          "decimals": 0,
          "noValue": "Нет данных",
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "green",
                "value": null
              },
              {
                "color": "red",
                "value": 1
              }
            ]
          }
        },
        "overrides": []
      },
      "options": {
        "colorMode": "value",
        "graphMode": "none",
        "textMode": "value_and_name",
        "orientation": "horizontal"
      }
    },
    {
      "id": 3,
      "title": "Синхронные реплики отчётов · ISR",
      "type": "timeseries",
      "description": "В норме 3, при отказе одного узла 2.",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "gridPos": {
        "x": 0,
        "y": 4,
        "w": 12,
        "h": 7
      },
      "targets": [
        {
          "refId": "A",
          "expr": "kafka_topic_partition_in_sync_replica{job=\"kafka\",topic=\"reports.files\"}",
          "legendFormat": "Партиция {{partition}}",
          "instant": false,
          "range": true
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "color": {
            "mode": "palette-classic"
          },
          "min": 0,
          "custom": {
            "lineWidth": 2,
            "fillOpacity": 10,
            "showPoints": "never"
          },
          "noValue": "Нет данных"
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "bottom"
        },
        "tooltip": {
          "mode": "multi"
        }
      }
    },
    {
      "id": 4,
      "title": "Отставание consumers",
      "type": "timeseries",
      "description": "Количество ещё не подтверждённых сообщений по партициям. Commit выполняется после сохранения файла в S3.",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "gridPos": {
        "x": 12,
        "y": 4,
        "w": 12,
        "h": 7
      },
      "targets": [
        {
          "refId": "A",
          "expr": "clamp_min(kafka_consumergroup_lag{job=\"kafka\",topic=\"reports.files\"}, 0)",
          "legendFormat": "{{consumergroup}} / {{partition}}",
          "instant": false,
          "range": true
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "color": {
            "mode": "palette-classic"
          },
          "min": 0,
          "custom": {
            "lineWidth": 2,
            "fillOpacity": 10,
            "showPoints": "never"
          },
          "noValue": "Нет данных"
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "bottom"
        },
        "tooltip": {
          "mode": "multi"
        }
      }
    },
    {
      "id": 5,
      "title": "Поступление сообщений",
      "type": "timeseries",
      "description": "Оценка сообщений/с по приросту конечных offsets отчётного топика.",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "gridPos": {
        "x": 0,
        "y": 11,
        "w": 12,
        "h": 7
      },
      "targets": [
        {
          "refId": "A",
          "expr": "sum(clamp_min(deriv(kafka_topic_partition_current_offset{job=\"kafka\",topic=\"reports.files\"}[$__rate_interval]), 0))",
          "legendFormat": "Сообщения/с",
          "instant": false,
          "range": true
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "ops",
          "color": {
            "mode": "palette-classic"
          },
          "min": 0,
          "custom": {
            "lineWidth": 2,
            "fillOpacity": 10,
            "showPoints": "never"
          },
          "noValue": "Нет данных"
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "bottom"
        },
        "tooltip": {
          "mode": "multi"
        }
      }
    },
    {
      "id": 6,
      "title": "Участники consumer group",
      "type": "timeseries",
      "description": "В норме две реплики files-service. Ноль или отсутствие данных требует проверки consumer group и exporter.",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "gridPos": {
        "x": 12,
        "y": 11,
        "w": 12,
        "h": 7
      },
      "targets": [
        {
          "refId": "A",
          "expr": "kafka_consumergroup_members{job=\"kafka\",consumergroup=\"files-service\"}",
          "legendFormat": "{{consumergroup}}",
          "instant": false,
          "range": true
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "color": {
            "mode": "palette-classic"
          },
          "min": 0,
          "custom": {
            "lineWidth": 2,
            "fillOpacity": 10,
            "showPoints": "never"
          },
          "noValue": "Нет данных"
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "bottom"
        },
        "tooltip": {
          "mode": "multi"
        }
      }
    }
  ]
}
