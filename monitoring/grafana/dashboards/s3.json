{
  "uid": "s3",
  "title": "S3 / SeaweedFS overview",
  "description": "Три volume server, две копии данных, S3-запросы и хранение. mini публикует общий registry master/filer/S3/volume.",
  "tags": [
    "labs",
    "s3"
  ],
  "schemaVersion": 41,
  "version": 1,
  "editable": false,
  "timezone": "browser",
  "refresh": "5s",
  "time": {
    "from": "now-15m",
    "to": "now"
  },
  "links": [
    {
      "title": "Services",
      "url": "http://localhost:3000/d/services",
      "type": "link",
      "targetBlank": false
    },
    {
      "title": "Kafka",
      "url": "http://localhost:3000/d/kafka",
      "type": "link",
      "targetBlank": false
    },
    {
      "title": "S3",
      "url": "http://localhost:3000/d/s3",
      "type": "link",
      "targetBlank": false
    }
  ],
  "panels": [
    {
      "id": 1,
      "title": "Доступность узлов хранения",
      "type": "stat",
      "description": "Успешный scrape metrics endpoint. mini включает master, filer, S3 gateway и первый volume server.",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "gridPos": {
        "x": 0,
        "y": 0,
        "w": 12,
        "h": 4
      },
      "targets": [
        {
          "refId": "A",
          "expr": "up{job=~\"seaweedfs|seaweedfs-volume\"}",
          "legendFormat": "{{job}} / {{instance}}",
          "instant": true,
          "range": false
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "color": {
            "mode": "thresholds"
          },
          "decimals": 0,
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "red",
                "value": null
              },
              {
                "color": "green",
                "value": 1
              }
            ]
          },
          "mappings": [
            {
              "type": "value",
              "options": {
                "0": {
                  "text": "DOWN",
                  "color": "red"
                },
                "1": {
                  "text": "UP",
                  "color": "green"
                }
              }
            }
          ],
          "noValue": "Нет данных"
        },
        "overrides": []
      },
      "options": {
        "colorMode": "value",
        "graphMode": "none",
        "textMode": "value_and_name",
        "orientation": "horizontal"
      }
    },
    {
      "id": 2,
      "title": "Объекты в bucket",
      "type": "stat",
      "description": "Логическое число объектов без повторного учёта реплик. Обновление статистики bucket может отставать от записи.",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "gridPos": {
        "x": 12,
        "y": 0,
        "w": 12,
        "h": 4
      },
      "targets": [
        {
          "refId": "A",
          "expr": "SeaweedFS_s3_bucket_object_count{job=\"seaweedfs\"}",
          "legendFormat": "{{bucket}}",
          "instant": true,
          "range": false
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "color": {
            "mode": "palette-classic"
          },
          "decimals": 0,
          "noValue": "Нет данных"
        },
        "overrides": []
      },
      "options": {
        "colorMode": "value",
        "graphMode": "none",
        "textMode": "value_and_name",
        "orientation": "horizontal"
      }
    },
    {
      "id": 3,
      "title": "Размер bucket · данные и копии",
      "type": "timeseries",
      "description": "Логический размер и размер с учётом всех копий. Данные CSV сжимаются; это не свободное место физического диска.",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "gridPos": {
        "x": 0,
        "y": 4,
        "w": 12,
        "h": 7
      },
      "targets": [
        {
          "refId": "A",
          "expr": "SeaweedFS_s3_bucket_size_bytes{job=\"seaweedfs\"}",
          "legendFormat": "{{bucket}} · логический",
          "instant": false,
          "range": true
        },
        {
          "refId": "B",
          "expr": "SeaweedFS_s3_bucket_physical_size_bytes{job=\"seaweedfs\"}",
          "legendFormat": "{{bucket}} · с репликами",
          "instant": false,
          "range": true
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "bytes",
          "color": {
            "mode": "palette-classic"
          },
          "min": 0,
          "custom": {
            "lineWidth": 2,
            "fillOpacity": 10,
            "showPoints": "never"
          },
          "noValue": "Нет данных"
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "bottom"
        },
        "tooltip": {
          "mode": "multi"
        }
      }
    },
    {
      "id": 4,
      "title": "Операции S3",
      "type": "timeseries",
      "description": "Запросов/с по типу операции.",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "gridPos": {
        "x": 12,
        "y": 4,
        "w": 12,
        "h": 7
      },
      "targets": [
        {
          "refId": "A",
          "expr": "sum by (type) (rate(SeaweedFS_s3_request_total{job=\"seaweedfs\"}[$__rate_interval]))",
          "legendFormat": "{{type}}",
          "instant": false,
          "range": true
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "reqps",
          "color": {
            "mode": "palette-classic"
          },
          "min": 0,
          "custom": {
            "lineWidth": 2,
            "fillOpacity": 10,
            "showPoints": "never"
          },
          "noValue": "Нет данных"
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "bottom"
        },
        "tooltip": {
          "mode": "multi"
        }
      }
    },
    {
      "id": 5,
      "title": "Ошибки S3 · 4xx / 5xx",
      "type": "timeseries",
      "description": "Ответы S3 с ошибками, включая отсутствующие объекты и неверную авторизацию.",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "gridPos": {
        "x": 0,
        "y": 11,
        "w": 12,
        "h": 7
      },
      "targets": [
        {
          "refId": "A",
          "expr": "sum by (code) (rate(SeaweedFS_s3_request_total{job=\"seaweedfs\",code=~\"[45]..\"}[$__rate_interval]))",
          "legendFormat": "HTTP {{code}}",
          "instant": false,
          "range": true
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "reqps",
          "color": {
            "mode": "palette-classic"
          },
          "min": 0,
          "custom": {
            "lineWidth": 2,
            "fillOpacity": 10,
            "showPoints": "never"
          },
          "noValue": "Нет данных"
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "bottom"
        },
        "tooltip": {
          "mode": "multi"
        }
      }
    },
    {
      "id": 6,
      "title": "Время ответа S3 · p95",
      "type": "timeseries",
      "description": "Появляется в интервалах, где были операции соответствующего типа.",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "gridPos": {
        "x": 12,
        "y": 11,
        "w": 12,
        "h": 7
      },
      "targets": [
        {
          "refId": "A",
          "expr": "histogram_quantile(0.95, sum by (type, le) (rate(SeaweedFS_s3_request_seconds_bucket{job=\"seaweedfs\"}[$__rate_interval])))",
          "legendFormat": "{{type}}",
          "instant": false,
          "range": true
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "s",
          "color": {
            "mode": "palette-classic"
          },
          "min": 0,
          "custom": {
            "lineWidth": 2,
            "fillOpacity": 10,
            "showPoints": "never"
          },
          "noValue": "Нет данных"
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "bottom"
        },
        "tooltip": {
          "mode": "multi"
        }
      }
    },
    {
      "id": 7,
      "title": "Данные томов по узлам",
      "type": "timeseries",
      "description": "Размер данных томов каждого volume server, включая внутреннюю коллекцию filer. Реплики учитываются на каждом узле.",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "gridPos": {
        "x": 0,
        "y": 18,
        "w": 12,
        "h": 7
      },
      "targets": [
        {
          "refId": "A",
          "expr": "sum by (instance) (SeaweedFS_volumeServer_total_disk_size{job=~\"seaweedfs|seaweedfs-volume\",type=\"normal\"})",
          "legendFormat": "{{instance}}",
          "instant": false,
          "range": true
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "bytes",
          "color": {
            "mode": "palette-classic"
          },
          "min": 0,
          "custom": {
            "lineWidth": 2,
            "fillOpacity": 10,
            "showPoints": "never"
          },
          "noValue": "Нет данных"
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "bottom"
        },
        "tooltip": {
          "mode": "multi"
        }
      }
    },
    {
      "id": 8,
      "title": "Нарушения размещения реплик",
      "type": "timeseries",
      "description": "Сумма native replica placement mismatch по коллекциям. В норме 0.",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "gridPos": {
        "x": 12,
        "y": 18,
        "w": 12,
        "h": 7
      },
      "targets": [
        {
          "refId": "A",
          "expr": "sum by (collection) (SeaweedFS_master_replica_placement_mismatch{job=\"seaweedfs\"})",
          "legendFormat": "{{collection}}",
          "instant": false,
          "range": true
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "color": {
            "mode": "palette-classic"
          },
          "min": 0,
          "custom": {
            "lineWidth": 2,
            "fillOpacity": 10,
            "showPoints": "never"
          },
          "noValue": "Нет данных"
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "bottom"
        },
        "tooltip": {
          "mode": "multi"
        }
      }
    }
  ]
}
